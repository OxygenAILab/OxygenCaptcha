NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
CHALLENGE_TTL_SECONDS=300
TOKEN_TTL_SECONDS=120
MAX_ATTEMPTS=3
RATE_LIMIT_MAX=120
OXY_SITES_JSON=[{"key":"oc_dev_public","secret":"oc_dev_secret","origins":["http://127.0.0.1:8787"],"actions":["submit"]}]
# Production should set a base64url or base64-encoded 32-byte Ed25519 seed.
OXY_TOKEN_SEED_BASE64=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OxygenAccount open platform. Keep the data key out of source control.
OXY_PLATFORM_DATA_FILE=.data/platform.json
OXY_PLATFORM_DATA_KEY_BASE64=
OXYGENACCOUNT_ISSUER=https://account.oxygenai.top
OXYGENACCOUNT_CLIENT_ID=
OXYGENACCOUNT_CLIENT_SECRET=
