{
  "name": "oxygenchallenge",
  "version": "26.0.0-alpha.9",
  "private": true,
  "type": "module",
  "description": "Risk-aware CAPTCHA API and embeddable challenge widget for captcha.oxygenai.top",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "python tests/browser_smoke.py",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "lucide": "1.70.0",
    "roughjs": "4.6.6",
    "zod": "4.6.7",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
